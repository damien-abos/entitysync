 #}
{% set section_defs = [
    {
        'type': 'add',
        'title': __('Additions', 'entitysync'),
        'help': __('Entities to create.', 'entitysync'),
        'icon': 'ti ti-circle-plus',
        'color': 'green',
    },
    {
        'type': 'link',
        'title': __('Links to existing entities', 'entitysync'),
        'help': __('Existing entities with the same name under the same parent, not yet managed by this model (or whose key changed). They will be managed from now on.', 'entitysync'),
        'icon': 'ti ti-link',
        'color': 'azure',
    },
    {
        'type': 'update',
        'title': __('Updates', 'entitysync'),
        'help': __('Managed entities whose name, comment or parent differ from the file.', 'entitysync'),
        'icon': 'ti ti-pencil',
        'color': 'yellow',
    },
    {
        'type': 'delete',
        'title': __('Deletions', 'entitysync'),
        'help': __('Managed entities absent from the filtered file. Deletion is permanent; not selected by default.', 'entitysync'),
        'icon': 'ti ti-trash',
        'color': 'red',
    },
] %}
{% set counts = snapshot.counts %}
{% set stats = snapshot.stats %}
{% set total = counts.add + counts.link + counts.update + counts.delete %}

<div class="container-fluid entitysync-preview" id="es-preview">
    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap align-items-center gap-2">
            <h3 class="card-title mb-0 me-auto">
                <i class="ti ti-file-import me-1"></i>
                {{ __('Import preview', 'entitysync') }} —
                <a href="{{ model.getLinkURL() }}">{{ model.fields['name'] }}</a>
            </h3>
            <span class="text-muted"><i class="ti ti-file me-1"></i>{{ job.fields['filename'] }}</span>
        </div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-auto"><span class="badge bg-secondary-lt fs-5">{{ __('%d rows', 'entitysync')|format(stats.rows) }}</span></div>
                <div class="col-auto"><span class="badge bg-secondary-lt fs-5">{{ __('%d filtered out', 'entitysync')|format(stats.filtered) }}</span></div>
                <div class="col-auto"><span class="badge {{ stats.invalid > 0 ? 'bg-orange-lt' : 'bg-secondary-lt' }} fs-5">{{ __('%d in error', 'entitysync')|format(stats.invalid) }}</span></div>
                <div class="col-auto"><span class="badge bg-secondary-lt fs-5">{{ __('%d entities expected', 'entitysync')|format(stats.nodes) }}</span></div>
                <div class="col-auto ms-auto text-muted small align-self-center">
                    {{ __('Encoding: %1$s, delimiter: %2$s', 'entitysync')|format(snapshot.csv.encoding, snapshot.csv.delimiter) }}
                </div>
            </div>
        </div>
    </div>

    {% if active_job %}
        <div class="alert alert-warning">
            <i class="ti ti-clock me-1"></i>
            {{ __('Another import of this model is waiting or running. Wait for it to end before applying this one.', 'entitysync') }}
            <a href="{{ active_job.url }}" class="ms-1">{{ __('Show its progress', 'entitysync') }}</a>
        </div>
    {% endif %}

    {% if snapshot.issues is not empty %}
        <div class="card mb-3">
            <div class="card-header">
                <h4 class="card-title mb-0">
                    <i class="ti ti-alert-triangle me-1"></i>
                    {{ __('Data issues', 'entitysync') }}
                    {% if snapshot.errors_total > 0 %}<span class="badge bg-danger ms-2">{{ snapshot.errors_total }}</span>{% endif %}
                    {% if snapshot.issues_total - snapshot.errors_total > 0 %}<span class="badge bg-warning ms-1">{{ snapshot.issues_total - snapshot.errors_total }}</span>{% endif %}
                </h4>
            </div>
            <div class="list-group list-group-flush entitysync-issues">
                {% for issue in snapshot.issues %}
                    <div class="list-group-item py-1">
                        {% if issue.severity == 'error' %}
                            <i class="ti ti-circle-x text-danger me-1"></i>
                        {% else %}
                            <i class="ti ti-alert-circle text-warning me-1"></i>
                        {% endif %}
                        {% if issue.line %}<span class="text-muted me-1">{{ __('Line %d', 'entitysync')|format(issue.line) }}</span>{% endif %}
                        {{ issue.message }}
                    </div>
                {% endfor %}
            </div>
            <div class="card-footer text-muted small">
                {% if snapshot.issues_total > snapshot.issues|length %}
                    <div>{{ __('Only the first %1$d of %2$d issues are listed.', 'entitysync')|format(snapshot.issues|length, snapshot.issues_total) }}</div>
                {% endif %}
                {% if snapshot.errors_total > 0 %}
                    <div>{{ __('Rows in error are ignored from the faulty level; the entities they refer to are never proposed for deletion.', 'entitysync') }}</div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% if total == 0 %}
        <div class="alert alert-success">
            <i class="ti ti-circle-check me-1"></i>
            {{ __('Nothing to change: GLPI already matches the file.', 'entitysync') }}
        </div>
        <form method="post" action="{{ action }}">
            <input type="hidden" name="job" value="{{ job.getID() }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <button type="submit" name="cancel" value="1" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left"></i><span>{{ __('Back to the model', 'entitysync') }}</span>
            </button>
        </form>
    {% else %}
        <div class="card mb-3 sticky-top entitysync-toolbar">
            <div class="card-body py-2 d-flex flex-wrap align-items-center gap-2">
                <div class="input-icon flex-grow-1" style="max-width: 28rem">
                    <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                    <input type="search" class="form-control" data-es-search
                           placeholder="{{ __('Filter by entity path…', 'entitysync') }}"
                           aria-label="{{ __('Filter by entity path…', 'entitysync') }}">
                </div>
                {% if owner %}
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-es-select="all"
                            title="{{ __('Every change matching the filter, on every page', 'entitysync') }}">{{ __('Select all', 'entitysync') }}</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-es-select="none"
                            title="{{ __('Every change matching the filter, on every page', 'entitysync') }}">{{ __('Select none', 'entitysync') }}</button>
                {% endif %}
                <label class="d-flex align-items-center gap-1 ms-2 mb-0 text-muted small">
                    {{ __('Per page', 'entitysync') }}
                    <select class="form-select form-select-sm w-auto" data-es-page-size>
                        {% for size in config.pageSizes %}
                            <option value="{{ size }}" {{ size == 100 ? 'selected' : '' }}>{{ size }}</option>
                        {% endfor %}
                    </select>
                </label>
                <span class="ms-auto text-muted" data-es-counter>
                    {{ __('%1$d selected change(s), including %2$d deletion(s)', 'entitysync')|format(summary.selected, summary.deletions) }}
                </span>
            </div>
        </div>

        {% for def in section_defs %}
            {% if counts[def.type] > 0 %}
                <div class="card mb-3 entitysync-section" data-es-section="{{ def.type }}">
                    <div class="card-header">
                        <label class="form-check mb-0 me-2" title="{{ __('Every change of this section matching the filter, on every page', 'entitysync') }}">
                            <input type="checkbox" class="form-check-input" data-es-section-toggle="{{ def.type }}" {{ owner ? '' : 'disabled' }}>
                        </label>
                        <h4 class="card-title mb-0">
                            <i class="{{ def.icon }} text-{{ def.color }} me-1"></i>
                            {{ def.title }}
                            <span class="badge bg-{{ def.color }}-lt ms-2" data-es-section-count>{{ counts[def.type] }}</span>
                        </h4>
                        <span class="text-muted small ms-3 d-none d-lg-inline">{{ def.help }}</span>
                    </div>
                    <div class="table-responsive" data-es-rows>
                        <div class="p-3 text-muted"><span class="spinner-border spinner-border-sm me-2"></span></div>
                    </div>
                    <div class="card-footer d-flex align-items-center gap-2 py-2" data-es-pager>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-es-page="first" aria-label="{{ __('First page', 'entitysync') }}"><i class="ti ti-chevrons-left"></i></button>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-es-page="prev" aria-label="{{ __('Previous page', 'entitysync') }}"><i class="ti ti-chevron-left"></i></button>
                        <span class="small text-muted" data-es-page-label></span>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-es-page="next" aria-label="{{ __('Next page', 'entitysync') }}"><i class="ti ti-chevron-right"></i></button>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-es-page="last" aria-label="{{ __('Last page', 'entitysync') }}"><i class="ti ti-chevrons-right"></i></button>
                        <span class="small text-muted ms-auto" data-es-items-label></span>
                    </div>
                </div>
            {% endif %}
        {% endfor %}

        <form method="post" action="{{ action }}" id="es-apply-form" data-submit-once>
            <input type="hidden" name="job" value="{{ job.getID() }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                {% if owner %}
                    <button type="submit" name="queue" value="1" class="btn btn-primary" data-es-apply {{ active_job ? 'disabled' : '' }}>
                        <i class="ti ti-check"></i><span>{{ __('Apply selected changes', 'entitysync') }}</span>
                    </button>
                {% endif %}
                <button type="submit" name="cancel" value="1" class="btn btn-outline-secondary" formnovalidate>
                    <i class="ti ti-x"></i><span>{{ __('Cancel', 'entitysync') }}</span>
                </button>
            </div>
            <p class="text-muted small mb-4">
                <i class="ti ti-info-circle me-1"></i>
                {{ __('The changes are applied in the background, by batches, by a GLPI automatic action. A progress page is shown after this step.', 'entitysync') }}
            </p>
        </form>

        <script type="application/json" id="es-preview-config">{{ config|json_encode|raw }}</script>
        <script>
            (function () {
                var start = function () {
                    window.EntitySync.initPreview(JSON.parse(document.getElementById('es-preview-config').textContent));
                };
                if (window.EntitySync) { start(); } else { document.addEventListener('DOMContentLoaded', start); }
            })();
        </script>
    {% endif %}
</div>
